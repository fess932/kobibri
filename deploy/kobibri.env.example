# Copy to /etc/kobibri.env, chown root:root, chmod 0600 — it holds the first-run
# admin password.

# Where the database, converted books and scaled covers live.
KOBIBRI_DATA_DIR=/var/lib/kobibri

KOBIBRI_LISTEN=127.0.0.1:8078

# The URL a reader will actually use. Set this behind any reverse proxy: it is
# what goes into the links kobibri hands the device, and the device remembers
# them permanently.
KOBIBRI_BASE_URL=https://books.example.com

# Honour X-Forwarded-Proto and X-Forwarded-Host. Only with a proxy in front.
KOBIBRI_TRUST_PROXY=1

# Creates the first account on a fresh install. Remove this line once you have
# signed in and set a real password.
KOBIBRI_ADMIN_PASSWORD=change-me-then-delete-this-line

# Endpoints kobibri does not implement are forwarded here, so the shop, firmware
# updates and previously purchased books keep working. Set to "off" to disable.
KOBIBRI_PROXY_UPSTREAM=https://storeapi.kobo.com

# Ceilings for the rebuildable caches, in bytes.
# KOBIBRI_KEPUB_CACHE_BYTES=4294967296
# KOBIBRI_COVER_CACHE_BYTES=1073741824

# Serve HTTPS directly instead of behind a proxy. Both or neither.
# Kobo's TLS stack is old, so kobibri serves HTTP/1.1 with TLS 1.2 as a minimum.
# KOBIBRI_TLS_CERT=/etc/kobibri/fullchain.pem
# KOBIBRI_TLS_KEY=/etc/kobibri/privkey.pem

# Use an external kepubify binary instead of the built-in library.
# KOBIBRI_KEPUBIFY_BIN=/usr/local/bin/kepubify

# How often to look for newly published chapters in imported serials.
# A duration such as 6h, or "off".
# KOBIBRI_IMPORT_CHECK_EVERY=6h

# debug | info | warn | error
KOBIBRI_LOG_LEVEL=info
