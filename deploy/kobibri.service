# Install to /etc/systemd/system/kobibri.service, then:
#   systemctl daemon-reload && systemctl enable --now kobibri
#
# Settings that differ per machine belong in /etc/kobibri.env, not here, so an
# upgrade of this unit does not overwrite them.

[Unit]
Description=kobibri — serves Calibre libraries to Kobo e-readers
Documentation=https://github.com/fess932/kobibri
After=network-online.target
Wants=network-online.target
# If the libraries live on a network share, wait for it:
# RequiresMountsFor=/srv/calibre

[Service]
Type=simple
ExecStart=/usr/local/bin/kobibri serve
Restart=on-failure
RestartSec=5s

# KOBIBRI_DATA_DIR, KOBIBRI_BASE_URL, KOBIBRI_ADMIN_PASSWORD and the rest.
# Keep it root-owned and mode 0600: it holds the first-run admin password.
EnvironmentFile=/etc/kobibri.env

DynamicUser=yes
StateDirectory=kobibri
# The database and caches. Override KOBIBRI_DATA_DIR only if you mean to.
Environment=KOBIBRI_DATA_DIR=/var/lib/kobibri

# kobibri only ever reads a Calibre library, so give it no more than that.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Binding below 1024 needs this; drop it when serving on 8078 behind a proxy.
# AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
