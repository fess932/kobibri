{{define "book.gohtml"}}
{{template "shell" .}}
{{$d := .Data}}
{{$b := $d.Book}}
{{$csrf := .CSRF}}
{{$L := .Lang}}

<div class="page-head">
  <div>
    <h1>{{$b.Title}}</h1>
    <p>{{authors $.Lang $b.AuthorsJSON}}{{if $b.SeriesName}} · {{$b.SeriesName}}{{if $b.SeriesIndex.Valid}} #{{$b.SeriesIndex.Float64}}{{end}}{{end}}</p>
  </div>
  <div class="actions">
    {{if $b.DownloadFormat}}<a class="btn btn-primary" href="/books/{{$b.ID}}/read">{{t $L "read.title"}}</a>{{end}}
    <a class="btn btn-quiet" href="/library">← {{t $L "book.back"}}</a>
  </div>
</div>

<div class="book-detail">
  <div>
    <img class="cover" src="/books/{{$b.ID}}/cover?size=large{{if $b.CoverImageID}}&v={{$b.CoverImageID}}{{end}}"
         alt="" width="200" height="267">
    {{if $d.Progress.Started}}
    <div class="book-progress" style="margin-top:10px">
      {{if eq $d.Progress.Status "Finished"}}
      <span class="pill pill-ok">{{t $L "read.finished"}}</span>
      {{else}}
      <span class="pill">{{$d.Progress.Rounded}}%</span>
      {{end}}
      {{if $d.Progress.LastRead}}<div class="mono muted">{{ago $d.Progress.LastRead}}</div>{{end}}
    </div>
    {{end}}
    <span class="book-flags" style="margin-top:10px">
      {{if $b.Syncable}}<span class="pill pill-ok">{{t $L "pill.readyForKobo"}}</span>
      {{else if $b.Hidden}}<span class="pill pill-warn">{{t $L "pill.hidden"}}</span>
      {{else if not $b.Available}}<span class="pill pill-warn">{{t $L "pill.notOnDisk"}}</span>
      {{else}}<span class="pill">{{t $L "pill.cannotSync"}}</span>{{end}}
    </span>
  </div>

  <div>
    {{if $.User.IsAdmin}}
    {{/* The only place a book with no series can be given one: a series page
         lists what is already in a series, so a stray book never appears on it. */}}
    <datalist id="series-names">
      {{range $d.SeriesNames}}<option value="{{.}}"></option>{{end}}
    </datalist>
    <section class="card">
      <div class="card-head">
        <div>
          <h2>{{t $L "series.edit"}}</h2>
          <p>{{if $d.SeriesOverride.Found}}{{t $L "series.editedOne"}}
             {{else if $b.SeriesName}}{{t $L "book.seriesFromLibrary"}}
             {{else}}{{t $L "book.seriesNone"}}{{end}}</p>
        </div>
        {{if $b.SeriesUUID}}
        <a class="btn btn-sm btn-quiet" href="/series/{{$b.SeriesUUID}}">{{t $L "book.seriesOpen"}} →</a>
        {{end}}
      </div>
      <div class="card-body">
        <form class="series-form" method="post" action="/books/{{$b.ID}}/series">
          <input type="hidden" name="csrf" value="{{$csrf}}">
          <div class="field" style="flex: 1 1 240px">
            <label for="series">{{t $L "series.edit"}}</label>
            <input id="series" name="series" list="series-names" value="{{$b.SeriesName}}"
                   placeholder="{{t $L "series.searchHint"}}" autocomplete="off">
          </div>
          <div class="field" style="flex: 0 0 90px">
            <label for="index">{{t $L "series.index"}}</label>
            <input id="index" name="index" inputmode="decimal"
                   value="{{if $b.SeriesIndex.Valid}}{{$b.SeriesIndex.Float64}}{{end}}"
                   placeholder="{{t $L "series.noIndex"}}">
          </div>
          <div class="actions">
            <button class="btn btn-primary" type="submit">{{t $L "series.save"}}</button>
            {{if $d.SeriesOverride.Found}}
            <button class="btn btn-quiet" type="submit" name="reset" value="1"
                    title="{{t $L "series.resetHint"}}">{{t $L "series.reset"}}</button>
            {{end}}
          </div>
        </form>
        <p class="hint">{{t $L "series.clearHint"}}</p>
      </div>
    </section>
    {{end}}

    <section class="card">
      <div class="card-head"><div><h2>{{t $L "book.download"}}</h2>
        <p>{{t $L "book.downloadLede"}}</p></div></div>
      <div class="card-body">
        {{if $d.Formats}}
        <div class="downloads">
          {{range $d.Formats}}
          <a class="download" href="{{.Href}}">
            <span class="fmt">{{.Label}}</span>
            <span class="why">{{.Why}}</span>
            {{if .Size}}<span class="size">{{bytes .Size}}</span>{{end}}
          </a>
          {{end}}
        </div>
        {{else}}
        <p class="empty">{{t $L "book.noFile"}}</p>
        {{end}}

        {{if eq $b.DownloadFormat "KEPUB"}}
        <p class="hint" style="margin-top:12px">{{t $L "book.kepubNameHint"}}</p>
        {{end}}

        {{if $d.ConvertError}}
        <p class="note note-bad" style="margin-top:14px">
          {{t $L "book.convertFailed"}} <span class="mono">{{$d.ConvertError}}</span>
        </p>
        {{end}}
      </div>
    </section>

    <section class="card">
      <div class="card-head">
        <div><h2>{{t $L "book.whereFrom"}}</h2>
          <p>{{t $L "book.whereFromLede"}}</p></div>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th></th><th>{{t $L "th.library"}}</th><th>{{t $L "th.titleThere"}}</th>
                <th>{{t $L "th.formats"}}</th><th class="num">{{t $L "th.priority"}}</th>
                <th>{{t $L "th.state"}}</th></tr>
          </thead>
          <tbody>
            {{range $i, $c := $d.Contributors}}
            <tr class="{{if $c.IsWinner}}is-winner{{end}} {{if $c.Missing}}is-missing{{end}}">
              <td><span class="rank">{{add $i 1}}</span></td>
              <td><strong>{{$c.SourceName}}</strong>
                  <div class="mono">calibre #{{$c.CalibreID}}</div></td>
              <td>{{$c.Title}}</td>
              <td>
                {{range $c.Formats}}
                <span class="pill {{if not .Present}}pill-warn{{end}}">
                  {{.Format}}{{if eq .Layout "pre-paginated"}} · {{t $L "pill.fixed"}}{{end}}{{if not .Present}} · {{t $L "pill.fileGone"}}{{end}}
                </span>
                {{end}}
              </td>
              <td class="num">{{$c.Priority}}</td>
              <td>
                {{if $c.Missing}}<span class="pill pill-warn">{{t $L "pill.goneFromLibrary"}}</span>
                {{else if $c.IsWinner}}<span class="pill pill-accent">{{t $L "pill.suppliesRecord"}}</span>
                {{else}}<span class="pill">{{t $L "pill.standby"}}</span>{{end}}
                {{if $c.IsCoverOwner}}<span class="pill">{{t $L "pill.cover"}}</span>{{end}}
                {{if $c.Pinned}}<span class="pill">{{t $L "book.splitOff"}}</span>{{end}}
                {{if and $.User.IsAdmin (not $c.Missing)}}
                  {{if $c.Pinned}}
                  <form class="inline-form" method="post" action="/books/{{$b.ID}}/rejoin/{{$c.SourceBookID}}">
                    <input type="hidden" name="csrf" value="{{$csrf}}">
                    <button class="btn btn-sm btn-quiet" type="submit">{{t $L "book.rejoin"}}</button>
                  </form>
                  {{else if gt (len $d.Contributors) 1}}
                  <form class="inline-form" method="post" action="/books/{{$b.ID}}/split/{{$c.SourceBookID}}">
                    <input type="hidden" name="csrf" value="{{$csrf}}">
                    <button class="btn btn-sm btn-quiet" type="submit">{{t $L "book.splitThis"}}</button>
                  </form>
                  {{end}}
                {{end}}
              </td>
            </tr>
            {{end}}
          </tbody>
        </table>
      </div>
    </section>

    {{if $d.HasReading}}
    {{$rs := $d.Reading}}
    <section class="card">
      <div class="card-head">
        <div><h2>{{t $L "stats.reading"}}</h2></div>
        <a class="btn btn-sm btn-quiet" href="/stats">{{t $L "stats.allBooks"}} →</a>
      </div>
      <div class="card-body">
        <dl class="tiles">
          <div class="tile">
            <dt>{{t $L "stats.timeRead"}}</dt>
            <dd>{{hm $L $rs.Minutes}}<span class="sub">{{num $rs.Sittings}} {{t $L "stats.sittings"}}</span></dd>
          </div>
          <div class="tile">
            <dt>{{t $L "stats.speed"}}</dt>
            <dd>{{if $rs.WPM}}{{rate $rs.WPM}}<span class="sub">{{t $L "stats.wpm"}}</span>
                {{else}}—<span class="sub">{{t $L "stats.notMeasured"}}</span>{{end}}</dd>
          </div>
          <div class="tile">
            <dt>{{t $L "stats.left"}}</dt>
            <dd>{{if $rs.RemainingMinutes}}{{hm $L $rs.RemainingMinutes}}<span class="sub">
                  {{t $L "stats.ofWords"}} {{num $rs.TotalWords}}</span>
                {{else}}—<span class="sub">{{t $L "stats.notMeasured"}}</span>{{end}}</dd>
          </div>
          <div class="tile">
            <dt>{{t $L "stats.doneBy"}}</dt>
            {{$when := $rs.Finish $rs.Pace}}
            <dd>{{if $when.IsZero}}—<span class="sub">{{t $L "stats.notMeasured"}}</span>
                {{else}}{{date $L $when}}<span class="sub">{{hm $L (rate $rs.Pace)}} {{t $L "stats.aDay"}}</span>{{end}}</dd>
          </div>
        </dl>

        {{if $rs.Sessions}}
        <h3>{{t $L "stats.sittingsTitle"}}</h3>
        <ul class="sessions">
          {{range $rs.Sessions}}
          <li>
            <span class="when">{{date $L .Start}} · {{clock .Start}}–{{clock .End}}</span>
            <span>{{hm $L .Minutes}}{{if .WPM}} · {{rate .WPM}} {{t $L "stats.wpm"}}{{end}}</span>
          </li>
          {{end}}
        </ul>
        {{end}}
      </div>

      {{if $rs.Chapters}}
      <div class="table-wrap">
        <table>
          <thead><tr>
            <th>{{t $L "stats.chapter"}}</th>
            <th class="num">{{t $L "stats.timeRead"}}</th>
            <th class="num">{{t $L "stats.speed"}}</th>
          </tr></thead>
          <tbody>
            {{range $rs.Chapters}}
            <tr>
              <td>{{if .Title}}{{.Title}}{{else}}<span class="mono">{{.Source}}</span>{{end}}</td>
              <td class="num">{{hm $L .Minutes}}</td>
              <td class="num">{{if .WPM}}{{rate .WPM}}{{else}}—{{end}}</td>
            </tr>
            {{end}}
          </tbody>
        </table>
      </div>
      {{end}}
    </section>
    {{end}}

    <section class="card">
      <div class="card-head"><div><h2>{{t $L "book.onReaders"}}</h2></div></div>
      {{if $d.Devices}}
      <div class="table-wrap">
        <table>
          <thead><tr><th>{{t $L "th.reader"}}</th><th>{{t $L "th.hasBook"}}</th>
                     <th>{{t $L "th.reading"}}</th><th>{{t $L "th.lastSync"}}</th></tr></thead>
          <tbody>
            {{range $d.Devices}}
            <tr>
              <td><strong>{{.DeviceName}}</strong></td>
              <td>
                {{if .Tombstoned}}<span class="pill pill-warn">{{t $L "pill.deletedOnDevice"}}</span>
                {{else if .InSnapshot}}<span class="pill pill-ok">{{t $L "pill.yes"}}</span>
                {{else}}<span class="pill">{{t $L "pill.notYet"}}</span>{{end}}
              </td>
              <td>
                {{if eq .Progress.Status "Finished"}}<span class="pill pill-ok">{{t $L "read.finished"}}</span>
                {{else if .Progress.Started}}{{.Progress.Rounded}}%
                {{else}}<span class="muted">{{t $L "read.notStarted"}}</span>{{end}}
                {{if .Progress.LastRead}}<div class="mono">{{ago .Progress.LastRead}}</div>{{end}}
              </td>
              <td>{{ago .LastSyncAt}}</td>
            </tr>
            {{end}}
          </tbody>
        </table>
      </div>
      {{else}}
      <div class="card-body"><p class="empty">{{t $L "book.noSync"}}</p></div>
      {{end}}
    </section>

    <section class="card">
      <div class="card-head"><div><h2>{{t $L "book.details"}}</h2></div></div>
      <div class="card-body">
        <ul class="meta">
          <li><span class="k">{{t $L "book.publisher"}}</span><span>{{if $b.Publisher}}{{$b.Publisher}}{{else}}—{{end}}</span></li>
          <li><span class="k">{{t $L "book.language"}}</span><span>{{$b.Language}}</span></li>
          <li><span class="k">ISBN</span><span class="mono">{{if $b.ISBN13}}{{$b.ISBN13}}{{else}}—{{end}}</span></li>
          <li><span class="k">{{t $L "book.sendsAs"}}</span><span>{{if $b.DownloadFormat}}{{$b.DownloadFormat}}{{else}}{{t $L "book.cannotRead"}}{{end}}</span></li>
          <li><span class="k">{{t $L "book.identifier"}}</span><span class="mono">{{$b.ID}}</span></li>
          <li><span class="k">{{t $L "book.revision"}}</span><span class="mono">{{$b.MetadataRev}}</span></li>
        </ul>

        {{if $b.DescriptionHTML}}
        <div class="blurb">{{$b.DescriptionHTML}}</div>
        {{end}}

        {{if $.User.IsAdmin}}
        <div class="actions" style="margin-top:18px">
          <form class="inline-form" method="post" action="/books/{{$b.ID}}/hidden">
            <input type="hidden" name="csrf" value="{{$csrf}}">
            <input type="hidden" name="hidden" value="{{if $b.Hidden}}0{{else}}1{{end}}">
            <button class="btn btn-sm {{if not $b.Hidden}}btn-bad{{end}}" type="submit">
              {{if $b.Hidden}}{{t $L "book.showAgain"}}{{else}}{{t $L "book.takeOff"}}{{end}}
            </button>
          </form>
          <form class="inline-form" method="post" action="/books/{{$b.ID}}/delete"
                onsubmit="return confirm('{{t $L "book.deleteConfirm"}}')">
            <input type="hidden" name="csrf" value="{{$csrf}}">
            <button class="btn btn-sm btn-bad" type="submit">{{t $L "book.delete"}}</button>
          </form>
          {{if eq $b.DownloadFormat "KEPUB"}}
          <form class="inline-form" method="post" action="/books/{{$b.ID}}/convert">
            <input type="hidden" name="csrf" value="{{$csrf}}">
            <button class="btn btn-sm" type="submit">{{t $L "book.convertAgain"}}</button>
          </form>
          {{end}}
        </div>
        <p class="hint">{{t $L "book.hideHint"}}</p>
        <p class="hint">{{t $L "book.deleteHint"}}</p>
        {{end}}
      </div>
    </section>
  </div>
</div>

{{template "shell-end" .}}
{{end}}
