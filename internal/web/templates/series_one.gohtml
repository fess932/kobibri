{{define "series_one.gohtml"}}
{{template "shell" .}}
{{$d := .Data}}
{{$L := .Lang}}
{{$admin := $.User.IsAdmin}}
{{$csrf := $.CSRF}}

<div class="page-head">
  <div>
    <h1>{{$d.Name}}</h1>
    <p>{{num (len $d.Rows)}} {{t $L "series.books"}}</p>
  </div>
  <a class="btn btn-quiet" href="/series">← {{t $L "series.title"}}</a>
</div>

{{if $admin}}
{{/* The datalist is what makes moving a stray book into an existing series a
     matter of picking the name rather than retyping it exactly right. */}}
<datalist id="series-names">
  {{range $d.Names}}<option value="{{.}}"></option>{{end}}
</datalist>
{{end}}

{{if $admin}}
<section class="card">
  <div class="card-head">
    <div>
      <h2>{{t $L "series.addBook"}}</h2>
      <p>{{t $L "series.addHint"}}</p>
    </div>
  </div>
  <div class="card-body">
    <form class="filters" method="get" action="/series/{{$d.UUID}}">
      <div class="field" style="flex: 1 1 260px">
        <label for="add">{{t $L "series.addSearch"}}</label>
        <input id="add" name="add" type="search" value="{{$d.Add}}"
               placeholder="{{t $L "series.addPlaceholder"}}">
      </div>
      <button class="btn" type="submit">{{t $L "library.filter"}}</button>
      {{if $d.Add}}<a class="btn btn-quiet" href="/series/{{$d.UUID}}">{{t $L "library.clear"}}</a>{{end}}
    </form>

    {{if $d.Candidates}}
    <ul class="sessions">
      {{range $d.Candidates}}
      <li>
        <span>
          <a href="/books/{{.ID}}">{{.Title}}</a>
          <span class="muted"> · {{authors $L .AuthorsJSON}}</span>
          {{if .SeriesName}}<span class="pill">{{.SeriesName}}</span>{{end}}
        </span>
        <form class="inline-form" method="post" action="/books/{{.ID}}/series">
          <input type="hidden" name="csrf" value="{{$csrf}}">
          <input type="hidden" name="back" value="/series/{{$d.UUID}}?add={{$d.Add}}">
          <input type="hidden" name="series" value="{{$d.Name}}">
          <label class="visually-hidden" for="add-index-{{.ID}}">{{t $L "series.editIndex"}}</label>
          <input id="add-index-{{.ID}}" name="index" inputmode="decimal" size="4"
                 value="{{$d.NextIndex}}" placeholder="{{t $L "series.index"}}">
          <button class="btn btn-sm btn-primary" type="submit">{{t $L "series.addOne"}}</button>
        </form>
      </li>
      {{end}}
    </ul>
    {{else if $d.Add}}
    <p class="empty">{{t $L "series.addNothing"}}</p>
    {{end}}
  </div>
</section>
{{end}}

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th></th>
        <th>{{t $L "series.index"}}</th>
        <th>{{t $L "th.title"}}</th>
        <th></th>
        {{if $admin}}<th>{{t $L "series.edit"}}</th>{{end}}
      </tr>
    </thead>
    <tbody>
      {{range $d.Rows}}
      <tr {{if not .Syncable}}class="is-dim"{{end}}>
        <td>
          <a class="cover-link" href="/books/{{.ID}}">
            <img class="cover" src="/books/{{.ID}}/cover{{if .CoverImageID}}?v={{.CoverImageID}}{{end}}"
                 alt="" loading="lazy" width="44" height="59">
          </a>
        </td>
        <td>{{if .SeriesIndex.Valid}}{{.SeriesIndex.Float64}}{{else}}<span class="muted">{{t $L "series.noIndex"}}</span>{{end}}</td>
        <td>
          <a class="book-title" href="/books/{{.ID}}">{{.Title}}</a><br>
          <span class="muted">{{authors $L .Authors}}</span>
        </td>
        <td>
          {{if .SeriesOverridden}}<span class="pill" title="{{t $L "series.editedOne"}}">{{t $L "series.edited"}}</span>{{end}}
          {{if eq .Progress.Status "Finished"}}<span class="pill pill-ok">{{t $L "read.finished"}}</span>
          {{else if .Progress.Started}}<span class="pill pill-accent">{{.Progress.Rounded}}%</span>{{end}}
          {{if .Hidden}}<span class="pill pill-warn">{{t $L "pill.hidden"}}</span>{{end}}
          {{if not .Available}}<span class="pill pill-warn">{{t $L "pill.notOnDisk"}}</span>{{end}}
        </td>
        {{if $admin}}
        <td>
          <form class="inline-form" method="post" action="/books/{{.ID}}/series">
            <input type="hidden" name="csrf" value="{{$csrf}}">
            <input type="hidden" name="back" value="/series/{{$d.UUID}}">
            <label class="visually-hidden" for="series-{{.ID}}">{{t $L "series.edit"}}</label>
            <input id="series-{{.ID}}" name="series" list="series-names" value="{{.SeriesName}}"
                   placeholder="{{t $L "series.searchHint"}}" size="18">
            <label class="visually-hidden" for="index-{{.ID}}">{{t $L "series.editIndex"}}</label>
            <input id="index-{{.ID}}" name="index" inputmode="decimal" size="4"
                   value="{{if .SeriesIndex.Valid}}{{.SeriesIndex.Float64}}{{end}}"
                   placeholder="{{t $L "series.index"}}">
            <button class="btn btn-sm" type="submit">{{t $L "series.save"}}</button>
            {{if .SeriesOverridden}}
            <button class="btn btn-sm btn-quiet" type="submit" name="reset" value="1"
                    title="{{t $L "series.resetHint"}}">{{t $L "series.reset"}}</button>
            {{end}}
          </form>
        </td>
        {{end}}
      </tr>
      {{end}}
    </tbody>
  </table>
</div>

{{if $admin}}<p class="hint">{{t $L "series.clearHint"}}</p>{{end}}

{{template "shell-end" .}}
{{end}}
